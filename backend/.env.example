DATABASE_URL=sqlite:///./app.db
CORS_ORIGINS=["http://localhost:8501","http://localhost:8502"]
ADMIN_TOKEN=change-me

# --- QR 로그인 / 카카오 (비워 두면 로그인 API는 mock 모드로 동작하도록 구현 예정) ---
PUBLIC_BASE_URL=http://localhost:8000
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/api/auth/kakao/callback
JWT_SECRET=change-me
# Supabase Auth 로 카카오 로그인을 처리할 때 (docs/PRODUCTION_PLAN.md 4장 가이드 참고, 코드 연동 예정)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LOGIN_TTL_SECONDS=180

# --- 문자 발송 (SMS_PROVIDER=solapi | sens) ---
SMS_PROVIDER=solapi
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=
# 아래는 네이버 클라우드 SENS 사용 시. SENS_OPT_OUT_NUMBER(무료수신거부)는 공급자 공통
SENS_SERVICE_ID=
SENS_ACCESS_KEY=
SENS_SECRET_KEY=
SENS_SENDER_NUMBER=
SENS_OPT_OUT_NUMBER=
SMS_MONTHLY_LIMIT=50
LMS_MONTHLY_LIMIT=10
SMS_DRY_RUN=true
JWT_EXPIRE_MINUTES=720

# --- 매장 / 고객 등급 (임시 기준) ---
STORE_NAME=역전할머니맥주
STORE_BRANCH=홍대점
STORE_TABLES=30
GRADE_REPEAT_VISITS=2
GRADE_REGULAR_VISITS=5
GRADE_DORMANT_DAYS=60

# dev | prod (prod 에서는 JWT_SECRET, ADMIN_TOKEN 이 기본값이면 서버가 뜨지 않음)
APP_ENV=dev
STORE_SLOGAN=옛날 그 맛 그대로, 시원한 생맥주 한 잔!
