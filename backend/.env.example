# 복사해서 사용: cp .env.example .env
APP_ENV=dev
DATABASE_URL=sqlite:///./app.db
ADMIN_TOKEN=change-me
JWT_SECRET=change-me
PUBLIC_BASE_URL=http://127.0.0.1:8000

# 개발용 DB 왕복 테스트 버튼/API. 사용이 끝나면 false로 끈다.
DEV_TEST_BUTTON=false

# 화면(Streamlit) 실행 환경에서만 사용한다.
# API_URL=http://127.0.0.1:8000
# DATA_SOURCE=auto
